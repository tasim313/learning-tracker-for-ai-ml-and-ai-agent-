# Where all JSON data lives. On Render this must be the persistent disk mount.
DATA_DIR=./data
# Automatic snapshots kept per user (1-100).
BACKUP_RETENTION=7

# Public base URL used in emailed links. Required for email links in production
# (Render sets RENDER_EXTERNAL_URL automatically, which is used as a fallback).
APP_URL=http://localhost:3000

# Comma-separated emails that receive the administrator role when they register.
ADMIN_EMAILS=

# Session idle lifetime in days (1-90). Sessions also end 90 days after sign-in.
SESSION_TTL_DAYS=14
# Secure cookies default to on in production. Set to false only for plain-HTTP local testing.
# COOKIE_SECURE=

# Email: resend | console | none. Default: console in development, none in production.
EMAIL_PROVIDER=console
# RESEND_API_KEY=
# EMAIL_FROM=Learning Tracker <no-reply@your-domain.example>
# Block sign-in until the email address is verified (only enforced when email delivery works).
REQUIRE_EMAIL_VERIFICATION=false
